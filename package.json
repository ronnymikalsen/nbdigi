{
  "name": "nbdigi",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "ng": "nx",
    "start": "nx serve nbdigi --host=0.0.0.0 --hmr",
    "build": "nx build nbdigi",
    "build:production": "nx build nbdigi --configuration=production",
    "build-sm": "node --max-old-space-size=4096 ./node_modules/.bin/nx build nbdigi --configuration=production --source-map",
    "ngsw:version": "ngsw-config dist/apps/nbdigi/browser apps/nbdigi/ngsw-config.json",
    "test": "nx test nbdigi",
    "lint": "nx lint nbdigi",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "affected:dep-graph": "nx graph --affected",
    "format": "nx format:write",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "update": "nx migrate latest",
    "update:check": "ng update",
    "dep-graph": "nx graph",
    "help": "nx help",
    "deploy": "yarn build:production && firebase deploy --only hosting --project nbdigi-9637d",
    "test:firestore-rules": "firebase emulators:exec --only firestore --project demo-nbdigi-rules-test --config firebase.rules-test.json \"node --test tools/tests/firestore-rules.test.cjs\"",
    "affected": "nx affected",
    "bundle-report": "yarn build:production --stats-json && webpack-bundle-analyzer dist/apps/nbdigi/browser/stats.json"
  },
  "private": true,
