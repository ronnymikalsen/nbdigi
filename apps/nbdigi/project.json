{
  "name": "nbdigi",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/nbdigi/src",
  "projectType": "application",
  "prefix": "apps/nbdigi",
  "generators": {
    "@schematics/angular:component": {
      "style": "scss"
    }
  },
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "aot": true,
        "outputPath": {
          "base": "dist/apps/nbdigi"
        },
        "index": "apps/nbdigi/src/index.html",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/nbdigi/tsconfig.app.json",
        "assets": [
          "apps/nbdigi/src/favicon.ico",
          "apps/nbdigi/src/assets",
          "apps/nbdigi/src/robots.txt",
          "apps/nbdigi/src/manifest.json",
          "apps/nbdigi/src/browserconfig.xml",
          "apps/nbdigi/src/apple-touch-icon.png",
          "apps/nbdigi/src/apple-touch-icon-precomposed.png"
        ],
        "styles": ["apps/nbdigi/src/styles.scss", "apps/nbdigi/src/theme.scss"],
        "stylePreprocessorOptions": {
          "includePaths": ["src/styles", "node_modules"]
        },
        "scripts": [
          "node_modules/openseadragon/build/openseadragon/openseadragon.min.js"
        ],
        "allowedCommonJsDependencies": [
          "hammerjs",
          "openseadragon",
          "material-moment-adapter",
          "moment",
          "xml2js",
          "@swimlane/ngx-charts",
          "rfdc",
          "sax",
          "events",
          "timers",
          "stream"
        ],
        "browser": "apps/nbdigi/src/main.ts"
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/nbdigi/src/environments/environment.ts",
              "with": "apps/nbdigi/src/environments/environment.prod.ts"
            }
          ],
          "optimization": true,
          "outputHashing": "all",
          "sourceMap": false,
          "namedChunks": false,
          "aot": true,
          "extractLicenses": true,
          "serviceWorker": "apps/nbdigi/ngsw-config.json",
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "2mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "6kb"
            }
          ]
        }
      }
    },
    "serve": {
      "executor": "@angular/build:dev-server",
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "options": {
        "buildTarget": "nbdigi:build"
      },
      "configurations": {
        "production": {
          "buildTarget": "nbdigi:build:production"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "nbdigi:build"
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/apps/nbdigi"],
      "options": {
        "passWithNoTests": true
      }
    },
    "deploy": {
      "executor": "@angular/fire:deploy",
      "options": {}
    }
  }
}
